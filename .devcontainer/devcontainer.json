{
  "name": "Hugo (arunsrin's notes)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/hugo:1": {
      "version": "0.147.7",
      "extended": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [1313, 1314],
  "portsAttributes": {
    "1313": {
      "label": "Hugo Server",
      "onAutoForward": "notify"
    },
    "1314": {
      "label": "Worktree Preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y jq && chmod +x scripts/*.sh && hugo version",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "vscodevim.vim",
        "budparr.language-hugo-html",
        "hugo-intel.hugo-vscode",
        "yzhang.markdown-all-in-one",
        "davidanson.vscode-markdownlint",
        "bierner.markdown-emoji"
      ],
      "settings": {
        "vim.useSystemClipboard": true,
        "vim.hlsearch": true,
        "[html]": {
          "editor.defaultFormatter": "vscode.html-language-features"
        }
      }
    }
  }
}
