[
  {{- $pages := where site.Pages "Kind" "in" (slice "page" "section" "home") -}}
  {{- range $i, $e := $pages -}}
  {{- if $i }},{{ end -}}
  {
    "title": {{ $e.Title | jsonify }},
    "permalink": {{ $e.RelPermalink | jsonify }},
    "content": {{ $e.Plain | jsonify }},
    "readingTime": {{ $e.ReadingTime | default 1 }},
    "tags": {{ $e.Params.tags | jsonify }}
  }
  {{- end -}}
]
